+static enum bpf_cheri_helper_operation
+bpf_cheri_gate4_call(const struct bpf_prog *prog,
+		     const struct bpf_insn *insn, u32 insn_index,
+		     u64 *target, const struct bpf_gate4_kfunc_call **call_out)
+{
+	const struct bpf_gate4_kfunc_call *call;
+	enum bpf_cheri_helper_operation operation = BPF_CHERI_HELPER_INVALID;
+
+	if (!bpf_gate4_kfunc_mode(prog))
+		return operation;
+	call = bpf_jit_find_gate4_kfunc_call(prog, insn, insn_index);
+	if (!call || call->object_btf_size != BPF_GATE4_OBJECT_SIZE ||
+	    !call->resolved_target)
+		return operation;
+
+	if (call->effect == BPF_GATE4_KFUNC_EFFECT_ACQUIRE) {
+		if (call->acquisition_ordinal == 1)
+			operation = prog->aux->ownership_lifetime_mode ==
+				BPF_OWNERSHIP_LIFETIME_G4_DIRECT ?
+				BPF_CHERI_HELPER_GATE4_ACQUIRE_DIRECT :
+				BPF_CHERI_HELPER_GATE4_ACQUIRE_A;
+		else if (call->acquisition_ordinal == 2)
+			operation = BPF_CHERI_HELPER_GATE4_ACQUIRE_B;
+	} else if (call->effect == BPF_GATE4_KFUNC_EFFECT_RELEASE) {
+		if (call->release_binding == 1)
+			operation = BPF_CHERI_HELPER_GATE4_RELEASE_A;
+		else if (call->release_binding == 2)
+			operation = BPF_CHERI_HELPER_GATE4_RELEASE_B;
+	}
+	if (operation == BPF_CHERI_HELPER_INVALID)
+		return operation;
+	if (target)
+		*target = call->resolved_target;
+	if (call_out)
+		*call_out = call;
+	return operation;
+}
