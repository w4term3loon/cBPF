+static int validate_gate4_kfunc_encoding(
+		const struct jit_ctx *ctx, u32 bpf_index,
+		struct bpf_cheri_certificate_stats *stats)
+{
+	const struct bpf_insn *insn = &ctx->prog->insnsi[bpf_index];
+	const struct bpf_cheri_state *state = &ctx->authority[bpf_index];
+	const struct bpf_gate4_kfunc_call *call = NULL;
+	enum bpf_cheri_helper_operation operation;
+	u32 expected[48];
+	u64 target = 0;
+	u8 dst = bpf2a64[insn->dst_reg];
+	u8 src = bpf2a64[insn->src_reg];
+	u8 r0 = bpf2a64[BPF_REG_0];
+
+	if (!bpf_gate4_kfunc_mode(ctx->prog))
+		return 0;
