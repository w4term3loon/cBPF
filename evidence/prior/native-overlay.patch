+static void kfunc_object_identity(struct btf *btf,
+				  const struct btf_type *func_proto, u32 flags,
+				  u32 *object_btf_id, u32 *object_btf_size)
+{
+	const struct btf_param *args;
+	const struct btf_type *t;
+	u32 type_id, size;
+
+	*object_btf_id = 0;
+	*object_btf_size = 0;
+	if (flags & KF_ACQUIRE) {
+		type_id = func_proto->type;
+	} else if (flags & KF_RELEASE) {
+		if (!btf_type_vlen(func_proto))
+			return;
+		args = btf_params(func_proto);
+		type_id = args[0].type;
+	} else {
+		return;
+	}
