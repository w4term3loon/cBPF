+/*
+ * This is deliberately an exact one-pair experiment, not a generic kfunc
+ * ABI.  The ordinary pointer returned by the pinned provider is converted to
+ * a 32-byte, read-only capability from executive DDC.  Provider-derived
+ * provenance is therefore a stated premise of the experiment, not a result.
+ */
+typedef void *(*bpf_gate4_acquire_fn)(unsigned long *);
+typedef void (*bpf_gate4_release_fn)(void *);
+
+noinline void *__capability
+bpf_cheri_gate4_acquire_impl(void *__capability scalar_cap, u64 target,
+			     u64 acquisition, u64 direct,
+			     uintcap_t *__capability private_out)
+{
+	struct bpf_cheri_lifetime_cell *cell = NULL;
+	void *__capability private_handle;
+	void *__capability public_handle;
+	void *__capability object_cap;
+	unsigned long *scalar_ptr;
+	void *object;
+
+	if (!target || (acquisition != 1 && acquisition != 2) || direct > 1 ||
+	    !cheri_check_cap(scalar_cap, sizeof(*scalar_ptr), CHERI_PERM_STORE) ||
+	    !cheri_check_cap(private_out, sizeof(*private_out),
+			     CHERI_PERM_STORE | CHERI_PERM_STORE_CAP))
+		return bpf_cheri_null_cap();
+	*private_out = (uintcap_t)bpf_cheri_null_cap();
+
+	/* Allocate and initialize the non-reused cell before invoking acquire. */
+	cell = kmalloc(sizeof(*cell), GFP_ATOMIC);
+	if (!cell || !IS_ALIGNED((unsigned long)cell, sizeof(*cell)))
+		goto fail_cell;
+	cell->object = (uintcap_t)bpf_cheri_null_cap();
+
+	private_handle = cheri_address_set(cheri_ddc_get(),
+					   (unsigned long)cell);
+	private_handle = cheri_bounds_set(private_handle, sizeof(*cell));
+	if (!cheri_tag_get(private_handle) ||
+	    cheri_base_get(private_handle) != (unsigned long)cell ||
+	    cheri_length_get(private_handle) != sizeof(*cell))
+		goto fail_cell;
+	private_handle = cheri_perms_clear(private_handle,
+		CHERI_PERMS_EXEC | PERM_EXECUTIVE | CHERI_PERM_STORE_CAP |
+		CHERI_PERM_STORE_LOCAL_CAP | PERM_SYS_REG);
+	public_handle = cheri_perms_clear(private_handle,
+					 CHERI_PERM_STORE | CHERI_PERM_GLOBAL);
+
+	/* Preserve the provider's real scalar-pointer argument and side effect. */
+	scalar_ptr = (unsigned long *)cheri_address_get(scalar_cap);
+	object = ((bpf_gate4_acquire_fn)(unsigned long)target)(scalar_ptr);
+	if (!object)
+		goto fail_cell;
+
+	object_cap = cheri_address_set(cheri_ddc_get(), (unsigned long)object);
+	object_cap = cheri_bounds_set(object_cap, BPF_GATE4_OBJECT_SIZE);
+	if (!cheri_tag_get(object_cap) ||
+	    cheri_base_get(object_cap) != (unsigned long)object ||
+	    cheri_length_get(object_cap) != BPF_GATE4_OBJECT_SIZE)
+		goto fail_acquired;
+	object_cap = cheri_perms_clear(object_cap,
+		CHERI_PERMS_WRITE | CHERI_PERMS_EXEC | PERM_EXECUTIVE |
+		PERM_SYS_REG);
+	cell->object = (uintcap_t)object_cap;
+	*private_out = (uintcap_t)private_handle;
+
+	if (bpf_cheri_test_certificate_transcript) {
+		pr_info("GATE4_ACQUIRE_BIND acquisition=%llu target=0x%llx object=0x%lx cell=0x%lx direct=%llu\n",
+			(unsigned long long)acquisition,
+			(unsigned long long)target, (unsigned long)object,
+			(unsigned long)cell, (unsigned long long)direct);
+		report_root_attestation("gate4_cell_private",
+			acquisition == 1 ? "c6_gateway_restore" :
+					   "c23_gateway_restore",
+			"kfunc_acquisition_cell", (unsigned long)cell,
+			sizeof(*cell), private_handle);
+		report_root_attestation("gate4_cell_public", "c0_kfunc_return",
+			"kfunc_acquisition_cell", (unsigned long)cell,
+			sizeof(*cell), public_handle);
+		report_root_attestation("gate4_object_transient", "trusted_only",
+			"prog_test_ref_kfunc", (unsigned long)object,
+			BPF_GATE4_OBJECT_SIZE, object_cap);
+	}
+
+	/* In the governed profile this local is dead before restricted BPF resumes. */
+	if (direct)
+		return object_cap;
+	object_cap = bpf_cheri_null_cap();
+	asm volatile("" : "+C" (object_cap) :: "memory");
+	return public_handle;
+
+fail_acquired:
+	/*
+	 * The exact 32-byte authority construction is a stop condition.  This
+	 * path deliberately does not guess a release target from the acquire
+	 * address; the governed run must fail and the fresh boot is discarded.
+	 */
+	pr_err("Gate-4 exact object authority construction failed after acquire\n");
+fail_cell:
+	if (cell)
+		kfree(cell);
+	return bpf_cheri_null_cap();
+}
+
+noinline u64 bpf_cheri_gate4_release_impl(u64 object, u64 target,
+					  u64 acquisition)
+{
+	if (!object || !target || (acquisition != 1 && acquisition != 2))
+		return 0;
+	if (bpf_cheri_test_certificate_transcript)
+		pr_info("GATE4_RELEASE_EFFECT_CALL acquisition=%llu target=0x%llx object=0x%llx\n",
+			(unsigned long long)acquisition,
+			(unsigned long long)target,
+			(unsigned long long)object);
+	((bpf_gate4_release_fn)(unsigned long)target)((void *)(unsigned long)object);
+	/* Preserve a zero r0 so an exact post-release fault has a stable result. */
+	return 0;
+}
