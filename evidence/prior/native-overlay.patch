+		       sizeof(tab->descs[0]), kfunc_desc_cmp_by_imm_off);
+	return desc && desc->owner_name &&
+	       call->function_btf_id == desc->func_id &&
+	       call->btf_object_id == desc->btf_object_id &&
+	       call->object_btf_id == desc->object_btf_id &&
+	       call->object_btf_size == desc->object_btf_size &&
+	       call->kfunc_flags == desc->kfunc_flags &&
+	       call->resolved_target == desc->addr &&
+	       call->owner_kind == desc->owner_kind &&
+	       !strcmp(call->owner_name, desc->owner_name) &&
+	       !memcmp(&call->func_model, &desc->func_model,
+		       sizeof(call->func_model));
+}
+
+const struct bpf_gate4_kfunc_call *
+bpf_jit_find_gate4_kfunc_call(const struct bpf_prog *prog,
+			      const struct bpf_insn *insn, u32 insn_idx)
+{
+	const struct bpf_gate4_kfunc_contract *contract;
+	u32 i;
+
+	contract = prog->aux->gate4_kfunc_contract;
+	if (!contract || !contract->valid)
+		return NULL;
+	for (i = 0; i < contract->nr_calls; i++) {
+		const struct bpf_gate4_kfunc_call *call = &contract->calls[i];
+
+		if (call->source_call_index == insn_idx &&
+		    ((call->owner_kind == BPF_GATE4_KFUNC_OWNER_VMLINUX &&
+		      !insn->off) ||
+		     (call->owner_kind == BPF_GATE4_KFUNC_OWNER_MODULE &&
+		      insn->off == 1)) &&
+		    gate4_contract_call_matches_desc(prog, call, insn))
+			return call;
+	}
+	return NULL;
+}
+
+int bpf_jit_update_gate4_kfunc_call_index(struct bpf_prog *prog,
+					 u32 original_idx, u32 new_idx)
+{
+	struct bpf_gate4_kfunc_contract *contract;
+	const struct bpf_insn *insn;
+	u32 i;
+
+	contract = prog->aux->gate4_kfunc_contract;
+	if (!contract || !contract->valid || new_idx >= prog->len)
+		return -EINVAL;
+	insn = &prog->insnsi[new_idx];
+	if (!bpf_pseudo_kfunc_call(insn))
+		return -EINVAL;
+	for (i = 0; i < contract->nr_calls; i++) {
+		struct bpf_gate4_kfunc_call *call = &contract->calls[i];
+
+		if (call->source_call_index == new_idx &&
+		    call->original_call_index != original_idx)
+			return -EINVAL;
+	}
+	for (i = 0; i < contract->nr_calls; i++) {
+		struct bpf_gate4_kfunc_call *call = &contract->calls[i];
+
+		if (call->original_call_index != original_idx)
+			continue;
+		if ((call->owner_kind == BPF_GATE4_KFUNC_OWNER_VMLINUX &&
+		     insn->off) ||
+		    (call->owner_kind == BPF_GATE4_KFUNC_OWNER_MODULE &&
+		     insn->off != 1) ||
+		    !gate4_contract_call_matches_desc(prog, call, insn))
+			return -EINVAL;
+		call->source_call_index = new_idx;
+		return 0;
+	}
+	return -ENOENT;
+}
