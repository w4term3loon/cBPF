+static void emit_gate4_acquire(enum bpf_cheri_helper_operation operation,
+			       u64 target, struct jit_ctx *ctx)
+{
+	const u8 r0 = bpf2a64[BPF_REG_0];
+
+	emit_addr_mov_i64(A64_R(5), target, ctx);
+	emit_cheri_helper_call(operation, ctx);
+	emit_cheri_cap_mov(r0, A64_R(0), ctx);
+}
+
+static void emit_gate4_release(enum bpf_cheri_helper_operation operation,
+			       u64 target, bool direct, struct jit_ctx *ctx)
+{
+	const u8 public_root = direct ?
+		(operation == BPF_CHERI_HELPER_GATE4_RELEASE_B ?
+		 BPF_GATE4_SECOND_CELL_CAP_REG : BPF_LIFETIME_CURRENT_CAP_REG) :
+		bpf2a64[BPF_REG_1];
+	const u8 private_root =
+		operation == BPF_CHERI_HELPER_GATE4_RELEASE_B ?
+		BPF_GATE4_SECOND_CELL_CAP_REG : BPF_LIFETIME_CURRENT_CAP_REG;
+	const u8 r0 = bpf2a64[BPF_REG_0];
+	const u8 public_tag = bpf2a64[TMP_REG_1];
+	const u8 private_tag = bpf2a64[TMP_REG_2];
+	const u8 object_address = bpf2a64[TMP_REG_2];
+
+	/*
+	 * The public argument must name the same acquisition cell as the hidden
+	 * private handle.  In the direct-capability causal control only, the
+	 * public argument is intentionally the object itself, so this equality
+	 * check is made against the private handle twice.
+	 */
+	emit(A64_MOVZ(1, r0, 0, 0), ctx);
+	emit(CHERI_CAP_GCTAG | (public_root << 5) | public_tag, ctx);
+	emit(CHERI_CAP_GCTAG | (private_root << 5) | private_tag, ctx);
+	emit(A64_CBZ(1, public_tag, 21), ctx);
+	emit(A64_CBZ(1, private_tag, 20), ctx);
+	emit(CHERI_CAP_GCVALUE | (public_root << 5) | public_tag, ctx);
+	emit(CHERI_CAP_GCVALUE | (private_root << 5) | private_tag, ctx);
+	emit(A64_CMP(1, public_tag, private_tag), ctx);
+	emit(A64_B_(A64_COND_NE, 16), ctx);
+
+	/* Resolve, extract the scalar provider pointer, and clear c5 first. */
+	emit(CHERI_CAP_CBASE_LDR | (private_root << 5) |
+	     BPF_LIFETIME_TRANSIENT_CAP_REG, ctx);
+	emit(CHERI_CAP_GCTAG |
+	     (BPF_LIFETIME_TRANSIENT_CAP_REG << 5) | public_tag, ctx);
+	emit(CHERI_CAP_GCVALUE |
+	     (BPF_LIFETIME_TRANSIENT_CAP_REG << 5) | object_address, ctx);
+	emit(A64_MOVZ(1, BPF_LIFETIME_TRANSIENT_CAP_REG, 0, 0), ctx);
+	emit(A64_CBZ(1, public_tag, 11), ctx);
+
+	/* This store is the release linearization point. */
+	emit(CHERI_LS_STRX | (private_root << 5) | A64_ZR, ctx);
+	emit(A64_MOVZ(1, private_root, 0, 0), ctx);
+	emit(A64_MOV(1, A64_R(0), object_address), ctx);
+	emit_addr_mov_i64(A64_R(5), target, ctx);
+	emit_cheri_helper_call(operation, ctx);
+	emit(A64_MOVZ(1, r0, 0, 0), ctx);
+}
