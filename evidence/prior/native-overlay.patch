+static void gate4_expected_addr_mov(u32 *expected, u8 reg, u64 target)
+{
+	expected[0] = A64_MOVN(1, reg, ~target & 0xffff, 0);
+	target >>= 16;
+	expected[1] = A64_MOVK(1, reg, target & 0xffff, 16);
+	target >>= 16;
+	expected[2] = A64_MOVK(1, reg, target & 0xffff, 32);
+}
+
+static void gate4_expected_release(u32 *expected,
+		enum bpf_cheri_helper_operation operation, u64 target, bool direct)
+{
+	u8 public_root = direct ?
+		(operation == BPF_CHERI_HELPER_GATE4_RELEASE_B ?
+		 BPF_GATE4_SECOND_CELL_CAP_REG : BPF_LIFETIME_CURRENT_CAP_REG) :
+		bpf2a64[BPF_REG_1];
+	u8 private_root = operation == BPF_CHERI_HELPER_GATE4_RELEASE_B ?
+		BPF_GATE4_SECOND_CELL_CAP_REG : BPF_LIFETIME_CURRENT_CAP_REG;
+	u8 r0 = bpf2a64[BPF_REG_0];
+	u8 public_tag = bpf2a64[TMP_REG_1];
+	u8 private_tag = bpf2a64[TMP_REG_2];
+
+	expected[0] = A64_MOVZ(1, r0, 0, 0);
+	expected[1] = CHERI_CAP_GCTAG | (public_root << 5) | public_tag;
+	expected[2] = CHERI_CAP_GCTAG | (private_root << 5) | private_tag;
+	expected[3] = A64_CBZ(1, public_tag, 21);
+	expected[4] = A64_CBZ(1, private_tag, 20);
+	expected[5] = CHERI_CAP_GCVALUE | (public_root << 5) | public_tag;
+	expected[6] = CHERI_CAP_GCVALUE | (private_root << 5) | private_tag;
+	expected[7] = A64_CMP(1, public_tag, private_tag);
+	expected[8] = A64_B_(A64_COND_NE, 16);
+	expected[9] = CHERI_CAP_CBASE_LDR | (private_root << 5) |
+		BPF_LIFETIME_TRANSIENT_CAP_REG;
+	expected[10] = CHERI_CAP_GCTAG |
+		(BPF_LIFETIME_TRANSIENT_CAP_REG << 5) | public_tag;
+	expected[11] = CHERI_CAP_GCVALUE |
+		(BPF_LIFETIME_TRANSIENT_CAP_REG << 5) | private_tag;
+	expected[12] = A64_MOVZ(1, BPF_LIFETIME_TRANSIENT_CAP_REG, 0, 0);
+	expected[13] = A64_CBZ(1, public_tag, 11);
+	expected[14] = CHERI_LS_STRX | (private_root << 5) | A64_ZR;
+	expected[15] = A64_MOVZ(1, private_root, 0, 0);
+	expected[16] = A64_MOV(1, A64_R(0), private_tag);
+	gate4_expected_addr_mov(&expected[17], A64_R(5), target);
+	expected[20] = A64_MOVZ(1, A64_R(4), operation, 0);
+	expected[21] = CHERI_CAP_MOV | (A64_LR << 5) | A64_R(13);
+	expected[22] = CHERI_BLRS | (BPF_HELPER_GATE_CAP_REG << 5);
+	expected[23] = A64_MOVZ(1, r0, 0, 0);
+}
