+static int inject_gate4_kfunc_reorder(struct bpf_prog *prog)
+{
+	struct bpf_gate4_kfunc_contract *contract =
+		prog->aux->gate4_kfunc_contract;
+	struct bpf_insn saved[2];
+	u8 mode = prog->aux->ownership_lifetime_mode;
+
+	if (!bpf_gate4_kfunc_mode(prog) ||
+	    mode == BPF_OWNERSHIP_LIFETIME_G4_VALID ||
+	    mode == BPF_OWNERSHIP_LIFETIME_G4_DOUBLE)
+		return 0;
