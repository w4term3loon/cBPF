+		if (insn->off || expected_cheri_memory_encoding(insn, ctx,
+				&memory_operation, &rt, &root, &cap_tmp) != 1)
+			return -EINVAL;
+		expected[0] = CHERI_CAP_CBASE_LDR | (src << 5) |
+			BPF_LIFETIME_TRANSIENT_CAP_REG;
+		expected[1] = memory_operation |
+			(BPF_LIFETIME_TRANSIENT_CAP_REG << 5) | rt;
+		expected[2] = A64_MOVZ(1, BPF_LIFETIME_TRANSIENT_CAP_REG, 0, 0);
+		if (validate_exact_native_range(ctx, bpf_index, expected, 3))
