+static const struct bpf_kfunc_desc *
+gate4_kfunc_desc(const struct bpf_prog *prog, const struct bpf_insn *insn)
+{
+	const struct bpf_kfunc_desc key = {
+		.imm = insn->imm,
+		.offset = insn->off,
+	};
+	struct bpf_kfunc_desc_tab *tab = prog->aux->kfunc_tab;
+
+	if (!tab)
+		return NULL;
+	return bsearch(&key, tab->descs, tab->nr_descs,
+		       sizeof(tab->descs[0]), kfunc_desc_cmp_by_imm_off);
+}
+
+static int finalize_gate4_kfunc(struct bpf_verifier_env *env, u8 mode)
+{
+	struct bpf_gate4_kfunc_contract *contract;
+	struct gate4_expected_profile expected;
+	struct bpf_prog *prog = env->prog;
+	u32 acquisition_ref[BPF_GATE4_MAX_KFUNC_CALLS] = {};
+	bool released[BPF_GATE4_MAX_KFUNC_CALLS] = {};
+	u32 object_size = 0, actual_calls = 0;
+	u8 spill_stores = 0, spill_loads = 0;
+	u32 i, j;
+	int err;
+
+	err = gate4_expected_profile(prog, &expected);
+	if (err)
+		return err;
+	if (prog->len != expected.len || !gate4_exact_source_shape(prog) ||
+	    prog->type != BPF_PROG_TYPE_SCHED_CLS ||
+	    env->subprog_cnt != 1 || !prog->gpl_compatible ||
+	    expected.nr_calls > BPF_GATE4_MAX_KFUNC_CALLS ||
+	    prog->aux->gate4_kfunc_contract)
+		goto reject;
+
+	for (i = 0; i < prog->len; i++) {
+		actual_calls += bpf_pseudo_kfunc_call(&prog->insnsi[i]);
+		spill_stores += env->insn_aux_data[i].ownership_lifetime_spill;
+		spill_loads += env->insn_aux_data[i].ownership_lifetime_reload;
+	}
+	if (actual_calls != expected.nr_calls ||
+	    spill_stores != (expected.spill_index >= 0) ||
+	    spill_loads != (expected.reload_index >= 0) ||
+	    (expected.spill_index >= 0 &&
+	     !env->insn_aux_data[expected.spill_index].ownership_lifetime_spill) ||
+	    (expected.reload_index >= 0 &&
+	     !env->insn_aux_data[expected.reload_index].ownership_lifetime_reload))
+		goto reject;
+
+	contract = kzalloc(sizeof(*contract), GFP_KERNEL);
+	if (!contract)
+		return -ENOMEM;
+	for (i = 0; i < expected.nr_calls; i++) {
+		const struct bpf_kfunc_desc *desc;
+		struct bpf_gate4_kfunc_call *call = &contract->calls[i];
+		const struct btf_type *func, *object;
+		const struct bpf_insn *insn;
+		const char *func_name, *object_name, *wanted_name;
+		u32 index = expected.call_index[i];
+		u32 wanted_flags;
+
+		insn = &prog->insnsi[index];
+		if (!bpf_pseudo_kfunc_call(insn) ||
+		    env->insn_aux_data[index].orig_idx != index)
+			goto reject_free;
+		desc = gate4_kfunc_desc(prog, insn);
+		if (!desc || !desc->btf || !desc->owner_name || !desc->addr ||
+		    !desc->btf_object_id || !desc->object_btf_id ||
+		    !desc->object_btf_size ||
+		    btf_obj_id(desc->btf) != desc->btf_object_id)
+			goto reject_free;
+
+		if (expected.effect[i] == BPF_GATE4_KFUNC_EFFECT_ACQUIRE) {
+			wanted_flags = KF_ACQUIRE | KF_RET_NULL;
+			wanted_name = "bpf_kfunc_call_test_acquire";
+			if (insn->off != 1 ||
+			    desc->owner_kind != BPF_GATE4_KFUNC_OWNER_MODULE ||
+			    strcmp(desc->owner_name, "bpf_testmod"))
+				goto reject_free;
+		} else {
+			wanted_flags = KF_RELEASE;
+			wanted_name = "bpf_kfunc_call_test_release";
+			if (insn->off ||
+			    desc->owner_kind != BPF_GATE4_KFUNC_OWNER_VMLINUX ||
+			    strcmp(desc->owner_name, "vmlinux"))
+				goto reject_free;
+		}
+		func = btf_type_by_id(desc->btf, desc->func_id);
+		object = btf_type_by_id(desc->btf, desc->object_btf_id);
+		if (!func || !object || !btf_type_is_func(func) ||
+		    !btf_type_is_struct(object) ||
+		    desc->kfunc_flags != wanted_flags)
+			goto reject_free;
+		func_name = btf_name_by_offset(desc->btf, func->name_off);
+		object_name = btf_name_by_offset(desc->btf, object->name_off);
+		if (strcmp(func_name, wanted_name) ||
