+	if (insn->code == (BPF_STX | BPF_MEM | BPF_DW) &&
+	    insn->dst_reg == BPF_REG_FP && insn->off == -8) {
+		expected[0] = CHERI_CAP_CBASE_STR |
+			(BPF_LIFETIME_SIDECAR_CAP_REG << 5) | src;
+		if (validate_exact_native_range(ctx, bpf_index, expected, 1))
+			return -EINVAL;
