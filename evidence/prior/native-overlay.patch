+struct gate4_expected_profile {
+	u32 len;
+	u32 call_index[BPF_GATE4_MAX_KFUNC_CALLS];
+	u8 effect[BPF_GATE4_MAX_KFUNC_CALLS];
+	s16 spill_index;
+	s16 reload_index;
+	u8 nr_calls;
+};
+
+static int gate4_expected_profile(const struct bpf_prog *prog,
+				  struct gate4_expected_profile *expected)
+{
+	if (!strcmp(prog->aux->name, "g4_btf_valid")) {
+		*expected = (struct gate4_expected_profile) {
+			.len = 11, .call_index = { 3, 8 },
+			.effect = { BPF_GATE4_KFUNC_EFFECT_ACQUIRE,
+				    BPF_GATE4_KFUNC_EFFECT_RELEASE },
+			.spill_index = -1, .reload_index = -1, .nr_calls = 2,
+		};
+	} else if (!strcmp(prog->aux->name, "g4_valid") ||
+		   !strcmp(prog->aux->name, "g4_stale_s")) {
+		*expected = (struct gate4_expected_profile) {
+			.len = 13, .call_index = { 3, 10 },
+			.effect = { BPF_GATE4_KFUNC_EFFECT_ACQUIRE,
+				    BPF_GATE4_KFUNC_EFFECT_RELEASE },
+			.spill_index = 6, .reload_index = 7, .nr_calls = 2,
+		};
+	} else if (!strcmp(prog->aux->name, "g4_stale_r") ||
+		   !strcmp(prog->aux->name, "g4_direct")) {
+		*expected = (struct gate4_expected_profile) {
+			.len = 12, .call_index = { 3, 9 },
+			.effect = { BPF_GATE4_KFUNC_EFFECT_ACQUIRE,
+				    BPF_GATE4_KFUNC_EFFECT_RELEASE },
+			.spill_index = -1, .reload_index = -1, .nr_calls = 2,
+		};
+	} else if (!strcmp(prog->aux->name, "g4_independent")) {
+		*expected = (struct gate4_expected_profile) {
+			.len = 26, .call_index = { 3, 11, 17, 21 },
+			.effect = { BPF_GATE4_KFUNC_EFFECT_ACQUIRE,
+				    BPF_GATE4_KFUNC_EFFECT_ACQUIRE,
+				    BPF_GATE4_KFUNC_EFFECT_RELEASE,
+				    BPF_GATE4_KFUNC_EFFECT_RELEASE },
+			.spill_index = 6, .reload_index = 14, .nr_calls = 4,
+		};
+	} else if (!strcmp(prog->aux->name, "g4_double")) {
+		*expected = (struct gate4_expected_profile) {
+			.len = 10, .call_index = { 3, 7 },
+			.effect = { BPF_GATE4_KFUNC_EFFECT_ACQUIRE,
+				    BPF_GATE4_KFUNC_EFFECT_RELEASE },
+			.spill_index = -1, .reload_index = -1, .nr_calls = 2,
+		};
+	} else {
+		return -ENOENT;
+	}
+	return 0;
+}
+
+#define G4_INSN(_i, _code, _dst, _src, _off, _imm) \
+	ownership_lifetime_insn(&prog->insnsi[_i], (_code), (_dst), (_src), \
+				 (_off), (_imm))
+#define G4_EXIT(_i) G4_INSN((_i), BPF_JMP | BPF_EXIT, 0, 0, 0, 0)
+
+static bool gate4_call_shape(const struct bpf_prog *prog, u32 index, s16 off)
+{
+	const struct bpf_insn *insn = &prog->insnsi[index];
+
+	return bpf_pseudo_kfunc_call(insn) && !insn->dst_reg &&
+	       insn->off == off && insn->imm;
+}
+
+static bool gate4_source_prefix(const struct bpf_prog *prog)
+{
+	return G4_INSN(0, BPF_ST | BPF_MEM | BPF_DW,
+		       BPF_REG_10, 0, -8, 0) &&
+	       G4_INSN(1, BPF_ALU64 | BPF_MOV | BPF_X,
+		       BPF_REG_1, BPF_REG_10, 0, 0) &&
+	       G4_INSN(2, BPF_ALU64 | BPF_ADD | BPF_K,
+		       BPF_REG_1, 0, 0, -8) &&
+	       gate4_call_shape(prog, 3, 1);
+}
+
+static bool gate4_exact_source_shape(const struct bpf_prog *prog)
+{
+	if (!gate4_source_prefix(prog))
+		return false;
+	if (!strcmp(prog->aux->name, "g4_btf_valid"))
+		return G4_INSN(4, BPF_JMP | BPF_JEQ | BPF_K,
+			       BPF_REG_0, 0, 5, 0) &&
+		       G4_INSN(5, BPF_ALU64 | BPF_MOV | BPF_X,
+			       BPF_REG_6, BPF_REG_0, 0, 0) &&
+		       G4_INSN(6, BPF_LDX | BPF_PROBE_MEM | BPF_W,
+			       BPF_REG_7, BPF_REG_6, 0, 0) &&
+		       G4_INSN(7, BPF_ALU64 | BPF_MOV | BPF_X,
+			       BPF_REG_1, BPF_REG_6, 0, 0) &&
+		       gate4_call_shape(prog, 8, 0) &&
+		       G4_INSN(9, BPF_ALU64 | BPF_MOV | BPF_X,
+			       BPF_REG_0, BPF_REG_7, 0, 0) && G4_EXIT(10);
+	if (!strcmp(prog->aux->name, "g4_valid") ||
+	    !strcmp(prog->aux->name, "g4_stale_s"))
+		return G4_INSN(4, BPF_JMP | BPF_JEQ | BPF_K,
+			       BPF_REG_0, 0, 7, 0) &&
+		       G4_INSN(5, BPF_ALU64 | BPF_MOV | BPF_X,
+			       BPF_REG_6, BPF_REG_0, 0, 0) &&
+		       G4_INSN(6, BPF_STX | BPF_MEM | BPF_DW,
+			       BPF_REG_10, BPF_REG_6, -8, 0) &&
+		       G4_INSN(7, BPF_LDX | BPF_MEM | BPF_DW,
+			       BPF_REG_7, BPF_REG_10, -8, 0) &&
+		       G4_INSN(8, BPF_LDX | BPF_PROBE_MEM | BPF_W,
+			       BPF_REG_8, BPF_REG_7, 0, 0) &&
+		       G4_INSN(9, BPF_ALU64 | BPF_MOV | BPF_X,
+			       BPF_REG_1, BPF_REG_6, 0, 0) &&
+		       gate4_call_shape(prog, 10, 0) &&
+		       G4_INSN(11, BPF_ALU64 | BPF_MOV | BPF_X,
+			       BPF_REG_0, BPF_REG_8, 0, 0) && G4_EXIT(12);
+	if (!strcmp(prog->aux->name, "g4_stale_r") ||
+	    !strcmp(prog->aux->name, "g4_direct"))
+		return G4_INSN(4, BPF_JMP | BPF_JEQ | BPF_K,
+			       BPF_REG_0, 0, 6, 0) &&
+		       G4_INSN(5, BPF_ALU64 | BPF_MOV | BPF_X,
+			       BPF_REG_6, BPF_REG_0, 0, 0) &&
+		       G4_INSN(6, BPF_ALU64 | BPF_MOV | BPF_X,
+			       BPF_REG_7, BPF_REG_0, 0, 0) &&
+		       G4_INSN(7, BPF_LDX | BPF_PROBE_MEM | BPF_W,
+			       BPF_REG_8, BPF_REG_7, 0, 0) &&
+		       G4_INSN(8, BPF_ALU64 | BPF_MOV | BPF_X,
+			       BPF_REG_1, BPF_REG_6, 0, 0) &&
+		       gate4_call_shape(prog, 9, 0) &&
+		       G4_INSN(10, BPF_ALU64 | BPF_MOV | BPF_X,
+			       BPF_REG_0, BPF_REG_8, 0, 0) && G4_EXIT(11);
+	if (!strcmp(prog->aux->name, "g4_double"))
+		return G4_INSN(4, BPF_JMP | BPF_JEQ | BPF_K,
+			       BPF_REG_0, 0, 4, 0) &&
+		       G4_INSN(5, BPF_ALU64 | BPF_MOV | BPF_X,
+			       BPF_REG_6, BPF_REG_0, 0, 0) &&
+		       G4_INSN(6, BPF_ALU64 | BPF_MOV | BPF_X,
+			       BPF_REG_1, BPF_REG_6, 0, 0) &&
+		       gate4_call_shape(prog, 7, 0) &&
+		       G4_INSN(8, BPF_ALU64 | BPF_MOV | BPF_K,
+			       BPF_REG_0, 0, 0, 42) && G4_EXIT(9);
+	if (strcmp(prog->aux->name, "g4_independent"))
+		return false;
+	return G4_INSN(4, BPF_JMP | BPF_JEQ | BPF_K,
+		       BPF_REG_0, 0, 20, 0) &&
+	       G4_INSN(5, BPF_ALU64 | BPF_MOV | BPF_X,
+		       BPF_REG_6, BPF_REG_0, 0, 0) &&
+	       G4_INSN(6, BPF_STX | BPF_MEM | BPF_DW,
+		       BPF_REG_10, BPF_REG_6, -8, 0) &&
+	       G4_INSN(7, BPF_ALU64 | BPF_MOV | BPF_K,
+		       BPF_REG_7, 0, 0, 0) &&
+	       G4_INSN(8, BPF_ST | BPF_MEM | BPF_DW,
+		       BPF_REG_10, 0, -16, 0) &&
+	       G4_INSN(9, BPF_ALU64 | BPF_MOV | BPF_X,
+		       BPF_REG_1, BPF_REG_10, 0, 0) &&
+	       G4_INSN(10, BPF_ALU64 | BPF_ADD | BPF_K,
+		       BPF_REG_1, 0, 0, -16) &&
+	       gate4_call_shape(prog, 11, 1) &&
+	       G4_INSN(12, BPF_JMP | BPF_JEQ | BPF_K,
+		       BPF_REG_0, 0, 3, 0) &&
+	       G4_INSN(13, BPF_ALU64 | BPF_MOV | BPF_X,
+		       BPF_REG_7, BPF_REG_0, 0, 0) &&
+	       G4_INSN(14, BPF_LDX | BPF_MEM | BPF_DW,
+		       BPF_REG_8, BPF_REG_10, -8, 0) &&
+	       G4_INSN(15, BPF_LDX | BPF_PROBE_MEM | BPF_W,
+		       BPF_REG_9, BPF_REG_8, 0, 0) &&
+	       G4_INSN(16, BPF_ALU64 | BPF_MOV | BPF_X,
+		       BPF_REG_1, BPF_REG_6, 0, 0) &&
+	       gate4_call_shape(prog, 17, 0) &&
+	       G4_INSN(18, BPF_JMP | BPF_JEQ | BPF_K,
+		       BPF_REG_7, 0, 5, 0) &&
+	       G4_INSN(19, BPF_LDX | BPF_PROBE_MEM | BPF_W,
+		       BPF_REG_9, BPF_REG_7, 0, 0) &&
+	       G4_INSN(20, BPF_ALU64 | BPF_MOV | BPF_X,
+		       BPF_REG_1, BPF_REG_7, 0, 0) &&
+	       gate4_call_shape(prog, 21, 0) &&
+	       G4_INSN(22, BPF_ALU64 | BPF_MOV | BPF_X,
+		       BPF_REG_0, BPF_REG_9, 0, 0) && G4_EXIT(23) &&
+	       G4_INSN(24, BPF_ALU64 | BPF_MOV | BPF_K,
+		       BPF_REG_0, 0, 0, 0) && G4_EXIT(25);
+}
+
+#undef G4_EXIT
+#undef G4_INSN
