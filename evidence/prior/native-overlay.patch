+	t = btf_type_skip_modifiers(btf, type_id, NULL);
+	if (!t || !btf_type_is_ptr(t))
+		return;
+	t = btf_type_skip_modifiers(btf, t->type, &type_id);
+	if (!t || IS_ERR(btf_resolve_size(btf, t, &size)))
+		return;
+	*object_btf_id = type_id;
+	*object_btf_size = size;
