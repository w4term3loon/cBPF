+		failures++;
+	}
+	pr_info("CBPF_SPATIAL_SELECTIVITY_SUMMARY mode=%s result=%s cases=%u permits=%u rejects=%u failures=%u provider=production comparators=trusted verifier_execution=0\n",
+		cbpf_selectivity_calibration ? "calibration" : "matrix",
+		failures ? "FAIL" : "PASS", cases, permits, rejects, failures);
