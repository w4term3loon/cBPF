+#ifdef CONFIG_CBPF_ARRAY_AUTHORITY
+void *cbpf_map_area_alloc(u64 size, int numa_node,
+			 void *__capability *allocation_cap)
+{
+	void *__capability cap;
+	void *area;
+
+	if (!allocation_cap)
+		return NULL;
+	*allocation_cap = NULL;
+	area = bpf_map_area_alloc(size, numa_node);
+	if (!area)
+		return NULL;
+
+	/* Hybrid allocator: initial root assignment remains trusted. */
+	cap = cheri_address_set(cheri_ddc_get(), (unsigned long)area);
+	cap = cheri_bounds_set_exact(cap, size);
+	cap = cheri_perms_and(cap, CBPF_ARRAY_DATA_PERMS);
+	if (!cheri_tag_get(cap) || cheri_is_sealed(cap) ||
+	    cheri_base_get(cap) != (unsigned long)area ||
+	    cheri_address_get(cap) != (unsigned long)area ||
+	    cheri_length_get(cap) != size ||
+	    cheri_perms_get(cap) != CBPF_ARRAY_DATA_PERMS) {
+		bpf_map_area_free(area);
+		return NULL;
+	}
+	*allocation_cap = cap;
+	return area;
+}
+#endif
