@@ -23,6 +23,17 @@ config ARCH_WANT_DEFAULT_BPF_JIT
 
 menu "BPF subsystem"
 
+config CBPF_KFUNC_GATE
+	bool "CBPF bounded Morello acquisition gates"
+	depends on ARM64_MORELLO && CHERI_PURECAP_UABI && BPF_SYSCALL && BPF_JIT
+	depends on DEBUG_INFO_BTF && NET
+	default n
+	help
+	  A defensive proof of concept for a small, verifier-accepted SCHED_CLS
+	  subset. Acquisitions use private capability cells and checked gates
+	  within one synchronous BPF_PROG_TEST_RUN invocation. Unsupported
