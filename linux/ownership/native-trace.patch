 }
+
+struct bpf_prog *cbpf_jit_compile(struct bpf_prog *prog)
+{
+	return cbpf_compile(prog, false);
+}
+
+#ifdef CONFIG_CBPF_OWNERSHIP_NATIVE_TRACE_TEST
+#define T_I(C, D, S, O, V) \
+	{ .code = (C), .dst_reg = (D), .src_reg = (S), .off = (O), .imm = (V) }
+#define T_IMM(D, V) T_I(BPF_ALU64 | BPF_MOV | BPF_K, D, 0, 0, V)
+#define T_COPY(D, S) T_I(BPF_ALU64 | BPF_MOV | BPF_X, D, S, 0, 0)
+#define T_CALL(O) T_I(BPF_JMP | BPF_CALL, 0, BPF_PSEUDO_KFUNC_CALL, 0, O)
+#define T_NULL(O) T_I(BPF_JMP | BPF_JEQ | BPF_K, BPF_REG_0, 0, O, 0)
+#define T_SPILL T_I(BPF_STX | BPF_MEM | BPF_DW, BPF_REG_10, BPF_REG_6, -8, 0)
+#define T_RELOAD T_I(BPF_LDX | BPF_MEM | BPF_DW, BPF_REG_8, BPF_REG_10, -8, 0)
+#define T_EXIT T_I(BPF_JMP | BPF_EXIT, 0, 0, 0, 0)
+
+static const struct bpf_insn cbpf_trace_positive[] = {
+	T_IMM(1, 0), T_CALL(CBPF_OP_ACQUIRE), T_NULL(16),
+	T_COPY(6, 0), T_SPILL,
+	T_IMM(1, 0), T_CALL(CBPF_OP_ACQUIRE), T_NULL(11),
+	T_COPY(7, 0), T_RELOAD, T_COPY(1, 8),
+	T_CALL(CBPF_OP_RELEASE), T_COPY(1, 7), T_CALL(CBPF_OP_READ),
+	T_COPY(9, 0), T_COPY(1, 7), T_CALL(CBPF_OP_RELEASE),
+	T_COPY(0, 9), T_EXIT,
+	T_IMM(0, 0), T_EXIT,
+};
+
+static const struct bpf_insn cbpf_trace_stale_read[] = {
+	T_IMM(1, 0), T_CALL(CBPF_OP_ACQUIRE), T_NULL(19),
+	T_COPY(6, 0), T_SPILL,
+	T_IMM(1, 0), T_CALL(CBPF_OP_ACQUIRE), T_NULL(14),
+	T_COPY(7, 0), T_RELOAD, T_COPY(1, 8),
+	T_CALL(CBPF_OP_RELEASE), T_COPY(1, 7), T_CALL(CBPF_OP_READ),
+	T_COPY(9, 0), T_RELOAD, T_COPY(1, 8), T_CALL(CBPF_OP_READ),
+	T_COPY(1, 7), T_CALL(CBPF_OP_RELEASE), T_IMM(0, 99), T_EXIT,
+	T_IMM(0, 0), T_EXIT,
+};
+
+static const struct bpf_insn cbpf_trace_repeated_release[] = {
+	T_IMM(1, 0), T_CALL(CBPF_OP_ACQUIRE), T_NULL(19),
+	T_COPY(6, 0), T_SPILL,
+	T_IMM(1, 0), T_CALL(CBPF_OP_ACQUIRE), T_NULL(14),
+	T_COPY(7, 0), T_RELOAD, T_COPY(1, 8),
+	T_CALL(CBPF_OP_RELEASE), T_COPY(1, 7), T_CALL(CBPF_OP_READ),
+	T_COPY(9, 0), T_RELOAD, T_COPY(1, 8), T_CALL(CBPF_OP_RELEASE),
+	T_COPY(1, 7), T_CALL(CBPF_OP_RELEASE), T_IMM(0, 99), T_EXIT,
+	T_IMM(0, 0), T_EXIT,
+};
+
+struct bpf_prog *
+cbpf_ownership_trace_program(enum cbpf_ownership_trace_case trace_case)
+{
+	const struct bpf_insn *insns;
+	struct bpf_prog *prog;
+	const char *name;
+	u32 count, pc;
+
+	switch (trace_case) {
+	case CBPF_TRACE_POSITIVE:
+		name = "positive";
+		insns = cbpf_trace_positive;
+		count = ARRAY_SIZE(cbpf_trace_positive);
+		break;
+	case CBPF_TRACE_STALE_READ:
+		name = "stale_read";
+		insns = cbpf_trace_stale_read;
+		count = ARRAY_SIZE(cbpf_trace_stale_read);
+		break;
+	case CBPF_TRACE_REPEATED_RELEASE:
+		name = "repeated_release";
+		insns = cbpf_trace_repeated_release;
+		count = ARRAY_SIZE(cbpf_trace_repeated_release);
+		break;
+	default:
+		return NULL;
+	}
+	prog = bpf_prog_alloc(bpf_prog_size(count), 0);
+	if (!prog)
+		return NULL;
+	prog->type = BPF_PROG_TYPE_SCHED_CLS;
+	prog->len = count;
+	prog->jit_requested = 1;
+	prog->gpl_compatible = 1;
+	prog->aux->cbpf_gate = true;
+	memcpy(prog->insnsi, insns, count * sizeof(*insns));
+	for (pc = 0; pc < count; ++pc)
+		pr_info("CBPF_TRACE_BPF case=%s pc=%u code=%02x dst=%u src=%u off=%d imm=%d\n",
+			name, pc, insns[pc].code, insns[pc].dst_reg,
+			insns[pc].src_reg, insns[pc].off, insns[pc].imm);
+	cbpf_compile(prog, true);
+	if (!prog->jited) {
+		bpf_prog_free(prog);
+		return NULL;
+	}
+	return prog;
+}
+#endif
