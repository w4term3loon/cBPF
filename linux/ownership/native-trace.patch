+	    insn->src_reg != BPF_PSEUDO_KFUNC_CALL || insn->dst_reg ||
+	    insn->off || insn->imm < CBPF_OP_ACQUIRE ||
+	    insn->imm > CBPF_OP_RELEASE)
+		return 0;
+	return insn->imm;
+}
