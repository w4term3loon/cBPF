diff --git a/kernel/bpf/Kconfig b/kernel/bpf/Kconfig
--- a/kernel/bpf/Kconfig
+++ b/kernel/bpf/Kconfig
@@ -34,6 +34,17 @@ config CBPF_KFUNC_GATE
 	  within one synchronous BPF_PROG_TEST_RUN invocation. Unsupported
 	  programs fail admission; the ordinary kfunc bodies have no effects.
 
+config CBPF_OWNERSHIP_NATIVE_TRACE_TEST
+	bool "CBPF synthetic native ownership containment trace"
+	depends on CBPF_KFUNC_GATE
+	default n
+	help
+	  Build and run three fixed init-only trusted native fixtures through
+	  the CBPF restricted entry, gateway, epilogue and cleanup wrapper.
+	  The fixtures exercise a positive A/B sequence, a stale read and a
+	  repeated release. They do not admit or execute verifier-rejected eBPF;
+	  this option exists only for synthetic native validation.
+
 config BPF_SYSCALL
 	bool "Enable bpf() system call"
 	select BPF
