+#ifdef CONFIG_CBPF_OWNERSHIP_NATIVE_TRACE_TEST
+static bool __init
+cbpf_native_trace_check(enum cbpf_ownership_trace_case trace_case,
+			const char *name)
+{
+	struct bpf_prog *prog = NULL;
+	u32 result = 0, expected = trace_case == CBPF_TRACE_POSITIVE ? 42 : 0;
+	bool rejects = trace_case != CBPF_TRACE_POSITIVE;
+	bool pass = false;
+
+	memset(&cbpf_native_trace_observation, 0,
+	       sizeof(cbpf_native_trace_observation));
+	cbpf_native_trace_active = name;
+	pr_info("CBPF_OWNERSHIP_TRACE case=%s phase=begin verified_bpf=0 scope=synthetic_native_production_path\n",
+		name);
+	prog = cbpf_ownership_trace_program(trace_case);
+	if (!prog)
+		goto out;
+	local_bh_disable();
+	result = cbpf_test_invoke(prog, NULL);
+	local_bh_enable();
+	pass = result == expected && cbpf_native_trace_observation.entered &&
+		cbpf_native_trace_observation.failed == rejects &&
+		cbpf_native_trace_observation.acquired == 2 &&
+		cbpf_native_trace_observation.released == 2 &&
+		cbpf_native_trace_observation.reads == 1 &&
+		cbpf_native_trace_observation.cleanup == rejects &&
+		cbpf_native_trace_observation.refs == 1 &&
+		!cbpf_native_trace_observation.tag_a &&
+		!cbpf_native_trace_observation.tag_b &&
+		cbpf_native_trace_observation.identity_observed == rejects &&
+		(!rejects ||
+		 (cbpf_native_trace_observation.public_tag &&
+		  cbpf_native_trace_observation.canonical &&
+		  !cbpf_native_trace_observation.private_tag &&
+		  cbpf_native_trace_observation.rejected_operation ==
+			(trace_case == CBPF_TRACE_STALE_READ ? 2 : 3)));
+out:
+	cbpf_native_trace_active = NULL;
+	pr_info("CBPF_OWNERSHIP_TRACE case=%s phase=end result=%s retval=%u entered=%u failed=%u acquired=%u released=%u reads=%u cleanup=%u refs=%u tagA=%u tagB=%u identity_observed=%u public_tag=%u canonical=%u private_tag=%u rejected_operation=%u verified_bpf=0 scope=synthetic_native_production_path\n",
+		name, pass ? "PASS" : "FAIL", result,
+		cbpf_native_trace_observation.entered,
+		cbpf_native_trace_observation.failed,
+		cbpf_native_trace_observation.acquired,
+		cbpf_native_trace_observation.released,
+		cbpf_native_trace_observation.reads,
+		cbpf_native_trace_observation.cleanup,
+		cbpf_native_trace_observation.refs,
+		cbpf_native_trace_observation.tag_a,
+		cbpf_native_trace_observation.tag_b,
+		cbpf_native_trace_observation.identity_observed,
+		cbpf_native_trace_observation.public_tag,
+		cbpf_native_trace_observation.canonical,
+		cbpf_native_trace_observation.private_tag,
+		cbpf_native_trace_observation.rejected_operation);
+	if (prog)
+		bpf_prog_free(prog);
+	return pass;
+}
+#endif
