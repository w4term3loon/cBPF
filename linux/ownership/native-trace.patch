+#ifdef CONFIG_CBPF_OWNERSHIP_NATIVE_TRACE_TEST
+enum cbpf_ownership_trace_case {
+	CBPF_TRACE_POSITIVE,
+	CBPF_TRACE_STALE_READ,
+	CBPF_TRACE_REPEATED_RELEASE,
+};
+
+struct bpf_prog *
+cbpf_ownership_trace_program(enum cbpf_ownership_trace_case trace_case);
+#endif
 #endif
 
 #endif
